<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Microsoft.Testing.Platform (global.json test runner): every MSTest project is its own executable.
       Keyed on the project name because IsTestProject is not yet defined when Directory.Build.props is
       evaluated. Test.Support is the shared harness library and Test.Benchmarks is a BenchmarkDotNet
       console, so neither is a test application. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Test.Support' and '$(MSBuildProjectName)' != 'Test.Benchmarks'">
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <!-- AdditionalProperties for the test projects' references to AppHost and the Uno WASM host: a direct test-project
       build skips the Uno WASM publish (TaskFlow.Uno.WasmHost.csproj). A solution build passes nothing, because the
       WASM host already skips that publish when SolutionDir is set, and a global property there would give AppHost,
       the WASM host and everything below them a second configuration that builds and cleans into the obj folders of
       the solution's own configuration. -->
  <PropertyGroup Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">
    <TaskFlowSkipUnoWasmBuildProperties>SkipUnoWasmBuild=true</TaskFlowSkipUnoWasmBuildProperties>
  </PropertyGroup>
</Project>
