<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.Testing.Platform makes this test project an executable, and the presentation tests run headless
         on the Uno reference assemblies (no Uno runtime host). Declaring the Reference variant states that
         intent to Uno.WinUI 7 instead of leaving it to infer a missing runtime host (UNOB0025). -->
    <UnoRuntimeVariant>Reference</UnoRuntimeVariant>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Moq" />
    <PackageReference Include="EF.Testing" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\UI\TaskFlow.Uno\Views\MainPage.xaml"
             Link="Presentation\MainPage.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\UI\TaskFlow.Uno\Views\CategoryTreePage.xaml"
             Link="Presentation\CategoryTreePage.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\UI\TaskFlow.Uno\Views\TagManagementPage.xaml"
             Link="Presentation\TagManagementPage.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\UI\TaskFlow.Blazor\Components\Pages\*.razor"
             Link="Presentation\BlazorPages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UI\TaskFlow.Uno.Core\TaskFlow.Uno.Core.csproj" />
    <ProjectReference Include="..\..\src\UI\TaskFlow.Uno.Presentation\TaskFlow.Uno.Presentation.csproj" />
    <!-- WasmHostHttpContractTests boots the static host in-process against a fixture; the fixture replaces the Uno build. -->
    <ProjectReference Include="..\..\src\Host\TaskFlow.Uno.WasmHost\TaskFlow.Uno.WasmHost.csproj" AdditionalProperties="$(TaskFlowSkipUnoWasmBuildProperties)" />
  </ItemGroup>

</Project>
