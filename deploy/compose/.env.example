# TaskFlow Portable lane - environment contract for deploy/compose.
#
# NAMES ONLY. Every value is deliberately blank: this file is committed, and the real .env is written on
# the VPS by the deploy job (and by CI for a config check). Copy it, fill it in, keep the copy out of git.
#
#   cp .env.example .env
#
# Compose interpolates only from .env in this directory, so the deploy job appends images.env into it.

# ---- Lane and provider switches (D-035) -------------------------------------------------------------
# TASKFLOW_LANE=Portable seeds every default below; each switch still wins when set explicitly.
TASKFLOW_LANE=
TASKFLOW_DB_PROVIDER=
TASKFLOW_MESSAGING_PROVIDER=
TASKFLOW_STORAGE_PROVIDER=
TASKFLOW_READMODEL_PROVIDER=
TASKFLOW_AUDIT_PROVIDER=
TASKFLOW_SEARCH_PROVIDER=
TASKFLOW_AI_PROVIDER=
TASKFLOW_DATAPROTECTION_PERSISTENCE=

# ---- Database (D-045) --------------------------------------------------------------------------------
# None, or Transaction when the connection strings below point at pgbouncer:6432 (--profile pooler).
Database__PostgreSql__PoolerMode=
ConnectionStrings__TaskFlowDbContextTrxn=
ConnectionStrings__TaskFlowDbContextQuery=
ConnectionStrings__TaskFlowFlowEngineDbContext=
ConnectionStrings__TickerQDbContext=

# ---- Cache, broker -----------------------------------------------------------------------------------
ConnectionStrings__Redis1=
ConnectionStrings__RabbitMq1=

# ---- Object storage, S3 arm (D-037) ------------------------------------------------------------------
# PublicServiceUrl is required: SigV4 signs the Host header, so a presigned URL must be signed against a
# host the browser can actually reach.
Storage__S3__ServiceUrl=
Storage__S3__PublicServiceUrl=
Storage__S3__Region=
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=
Storage__S3__ForcePathStyle=

# ---- Azure surface retained in this lane: Key Vault + App Configuration (D-042, D-044) ---------------
AppConfig__Endpoint=
# EnvironmentCredential inside DefaultAzureCredential. Use the secret OR the certificate path, not both.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=

# ---- Encryption (D-023, D-043) -----------------------------------------------------------------------
DataProtectionEncryptionKeyUrl=
Database__Encryption__KeyUrl=
Database__Encryption__LocalKeyBase64=
Database__Encryption__BlindIndexKeyBase64=

# ---- Internal gRPC read hop (D-054) ------------------------------------------------------------------
Grpc__TaskFlowRead__Address=

# ---- Observability -----------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Edge --------------------------------------------------------------------------------------------
CADDY_DOMAIN=
ACME_EMAIL=
# Public origin the Blazor host calls for the API - https://<CADDY_DOMAIN> on the VPS.
Gateway__BaseUrl=

# ---- Images ------------------------------------------------------------------------------------------
# Written by the deploy job as images.env and appended into .env; see images.env.example.
TASKFLOW_GATEWAY_IMAGE=
TASKFLOW_API_IMAGE=
TASKFLOW_SCHEDULER_IMAGE=
TASKFLOW_MIGRATOR_IMAGE=
TASKFLOW_BLAZOR_IMAGE=
# Pinned to a published tag by default (see docker-compose.yml); pin a digest here before production.
PGBOUNCER_IMAGE=
