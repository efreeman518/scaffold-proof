# TaskFlow NonAzure lane - environment contract for deploy/compose.
#
# This committed template contains clearly marked non-production values so a clean-clone Compose schema check
# is runnable. The checked lane/provider values are deliberate D-060 defaults. On a VPS, copy it to
# .env.base, replace every CHANGE_ME value, and keep both .env.base and generated .env out of git.
#
#   cp .env.example .env.base
#
# Compose interpolates only from generated .env in this directory. The deploy job rebuilds that file from
# operator-managed .env.base plus workflow-managed images.env on every deploy and rollback.

# ---- Strict NonAzure lane contract (D-060) -----------------------------------------------------------
# Keep these lane-owned values. MongoDb is the only allowed ReadModel alternative and requires --profile mongo.
Hosting__Lane=NonAzure
Database__Provider=PostgreSql
Messaging__Provider=RabbitMq
Storage__Provider=S3
ReadModel__Provider=PostgreSqlJsonb
Audit__Provider=Relational
Search__Provider=Sql
AiServices__Provider=None
DataProtection__Persistence=Redis

# ---- Database (D-045) --------------------------------------------------------------------------------
# None, or Transaction when the connection strings below point at pgbouncer:6432 (--profile pooler).
Database__PostgreSql__PoolerMode=
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
ConnectionStrings__TaskFlowDbContextTrxn=Host=postgres;Port=5432;Database=taskflow;Username=taskflow;Password=CHANGE_ME_POSTGRES_PASSWORD
ConnectionStrings__TaskFlowDbContextQuery=Host=postgres;Port=5432;Database=taskflow;Username=taskflow;Password=CHANGE_ME_POSTGRES_PASSWORD
ConnectionStrings__TaskFlowFlowEngineDbContext=Host=postgres;Port=5432;Database=taskflow;Username=taskflow;Password=CHANGE_ME_POSTGRES_PASSWORD
ConnectionStrings__TickerQDbContext=Host=postgres;Port=5432;Database=taskflow;Username=taskflow;Password=CHANGE_ME_POSTGRES_PASSWORD

# ---- Cache, broker -----------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ConnectionStrings__Redis1=redis:6379,password=CHANGE_ME_REDIS_PASSWORD,abortConnect=false
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
# EF.Messaging RabbitMqRegistration binds this section. Keep the connection string alias below for health checks.
Messaging__RabbitMq__ConnectionString=amqp://taskflow:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
ConnectionStrings__RabbitMq1=amqp://taskflow:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/

# ---- Object storage, S3 arm (D-037) ------------------------------------------------------------------
# PublicServiceUrl is required: SigV4 signs the Host header, so a presigned URL must be signed against a
# host the browser can actually reach.
Storage__S3__ServiceUrl=http://seaweedfs:8333
Storage__S3__PublicServiceUrl=https://s3.example.invalid
Storage__S3__Region=us-east-1
Storage__S3__AccessKeyId=CHANGE_ME_S3_ACCESS_KEY
Storage__S3__SecretAccessKey=CHANGE_ME_S3_SECRET_KEY
# These credentials configure SeaweedFS and its signed S3 client; do not leave them blank in a real deployment.
Storage__S3__ForcePathStyle=true

# ---- Explicit MongoDB read-model alternative ----------------------------------------------------------
# Set ReadModel__Provider=MongoDb and start with `docker compose --profile mongo up -d --wait`.
MONGO_INITDB_ROOT_USERNAME=taskflow
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
ConnectionStrings__MongoDb1=

# ---- Encryption (D-023, D-043) -----------------------------------------------------------------------
Database__Encryption__LocalKeyBase64=CHANGE_ME_VALID_32_BYTE_BASE64_KEY
Database__Encryption__BlindIndexKeyBase64=CHANGE_ME_VALID_32_BYTE_BASE64_KEY

# ---- Internal gRPC read hop (D-054) ------------------------------------------------------------------
Grpc__TaskFlowRead__Address=http://api:8081

# ---- Observability (D-061) ---------------------------------------------------------------------------
# OpenObserve receives the plaintext bootstrap credentials. TaskFlow hosts receive only the base64 encoding
# of `organization:o2oi_ingestion_token`; docker-compose.yml adds the `Basic ` prefix to the OTLP header.
OPENOBSERVE_ROOT_EMAIL=CHANGE_ME_OPENOBSERVE_ROOT_EMAIL
OPENOBSERVE_ROOT_PASSWORD=CHANGE_ME_OPENOBSERVE_ROOT_PASSWORD
OPENOBSERVE_OTLP_BASIC_CREDENTIAL=CHANGE_ME_BASE64_ORGANIZATION_COLON_O2OI_TOKEN
OPENOBSERVE_ORGANIZATION=default
OPENOBSERVE_STREAM_NAME=taskflow
# Single-node global retention. OpenObserve requires at least 3 days; keep this short on a small VPS.
OPENOBSERVE_RETENTION_DAYS=14
# Logs and traces stay enabled. Metrics are opt-in because they dominate telemetry volume for this lane.
OpenTelemetry__MetricsEnabled=false

# ---- Edge --------------------------------------------------------------------------------------------
CADDY_DOMAIN=taskflow.example.invalid
ACME_EMAIL=operator@example.invalid
# Public origin the Blazor host calls for the API - https://<CADDY_DOMAIN> on the VPS.
Gateway__BaseUrl=https://taskflow.example.invalid
# Gateway origin supplied at static-container startup, never baked into React or Uno bundles.
GATEWAY_BASE_URL=https://taskflow.example.invalid
# Three distinct browser origins allowed by both Gateway and API CORS.
BLAZOR_UI_ORIGIN=https://taskflow.example.invalid
REACT_UI_ORIGIN=https://react.example.invalid
UNO_UI_ORIGIN=https://uno.example.invalid
REACT_UI_DOMAIN=react.example.invalid
UNO_UI_DOMAIN=uno.example.invalid
# Browser-reachable S3 hostname routed by Caddy to seaweedfs:8333.
S3_PUBLIC_DOMAIN=s3.example.invalid

# ---- Optional pooler image --------------------------------------------------------------------------
# Pinned to a published tag by default (see docker-compose.yml); pin a digest here before production.
PGBOUNCER_IMAGE=
