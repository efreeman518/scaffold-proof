# Digest-pinned application images. The deploy job writes exactly this shape to deploy/compose/images.env
# on the VPS from the build-images workflow outputs, then appends it into .env so compose can interpolate.
# images.env is git-ignored; this example exists so `docker compose config` is runnable from a clean clone.
#
# Values here are placeholders with a floating tag. A real images.env always carries @sha256:... digests -
# that is what makes `docker compose pull` and the rollback path reproducible.
TASKFLOW_GATEWAY_IMAGE=ghcr.io/efreeman518/taskflow-gateway:latest
TASKFLOW_API_IMAGE=ghcr.io/efreeman518/taskflow-api:latest
TASKFLOW_SCHEDULER_IMAGE=ghcr.io/efreeman518/taskflow-scheduler:latest
TASKFLOW_MIGRATOR_IMAGE=ghcr.io/efreeman518/taskflow-db-migrator:latest
TASKFLOW_BLAZOR_IMAGE=ghcr.io/efreeman518/taskflow-blazor:latest
