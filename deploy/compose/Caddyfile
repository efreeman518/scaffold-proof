# TaskFlow NonAzure lane edge (D-060, D-036). TLS is automatic: Caddy solves an ACME challenge for
# {$CADDY_DOMAIN} on first start and renews on its own, which is the entire reason this is the only
# container publishing 80 and 443.
{
	email {$ACME_EMAIL}
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	# Health and the public API both terminate at the YARP gateway, which owns the edge rate limiter
	# (D-050) and the Api's readiness view (D-049).
	@gateway path /healthz* /health/* /api/*
	handle @gateway {
		reverse_proxy gateway:8080 {
			health_uri /healthz/ready
			health_interval 10s
			health_timeout 5s
			health_status 200
		}
	}

	# Everything else is the Blazor Server UI. Its circuits are per-connection server state, so a
	# second replica would need affinity here - see README.md "Single-node ceiling".
	handle {
		reverse_proxy blazor:8080 {
			health_uri /healthz/ready
			health_interval 10s
			health_timeout 5s
			health_status 200
		}
	}
}

{$REACT_UI_DOMAIN} {
	encode zstd gzip
	reverse_proxy react:8080 {
		health_uri /
		health_interval 10s
		health_timeout 5s
		health_status 200
	}
}

{$UNO_UI_DOMAIN} {
	encode zstd gzip
	reverse_proxy uno:8080 {
		health_uri /
		health_interval 10s
		health_timeout 5s
		health_status 200
	}
}

# S3 presigned URLs must resolve in the browser, not only on the Compose network. SeaweedFS remains
# internal because this edge host is its sole public route.
{$S3_PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy seaweedfs:8333 {
		# S3 requires SigV4, so probe the unauthenticated master control plane instead of unsigned S3 root.
		health_port 9333
		health_uri /cluster/healthz
		health_interval 10s
		health_timeout 5s
		health_status 200
	}
}
