<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Unit" />
    <InternalsVisibleTo Include="Test.Integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <!-- D-043: Data Protection key-ring persistence, lifted here from TaskFlow.Api so Gateway/Scheduler can share it. -->
    <PackageReference Include="EF.AspNetCore.DataProtection" />
    <PackageReference Include="EF.Host" />
    <PackageReference Include="EF.Common" />
    <!-- EF.AspNetCore.HealthChecks.MemoryHealthCheck; this project already references Microsoft.AspNetCore.App. -->
    <PackageReference Include="EF.AspNetCore" />
    <PackageReference Include="EF.Data" />
    <PackageReference Include="EF.BackgroundServices" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="EF.Storage.Contracts" />
    <!-- D-037: the S3 arm of the object-storage switch (repository, bucket provisioner, DI wiring). -->
    <PackageReference Include="EF.Storage.S3" />
    <!-- S19/S20: the blob container health check (the Blob arm itself is in Infrastructure.Storage), and the Cosmos
         health check and client options with cross-region hedging. -->
    <PackageReference Include="EF.Storage" />
    <PackageReference Include="EF.CosmosDb" />
    <PackageReference Include="EF.Audit.Contracts" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <!-- M14/M17: Service Bus outbox transport and health check. -->
    <PackageReference Include="EF.Messaging" />
    <PackageReference Include="EF.FlowEngine" />
    <PackageReference Include="EF.FlowEngine.StateStore.Sql" />
    <PackageReference Include="EF.FlowEngine.Locks.Sql" />
    <PackageReference Include="EF.FlowEngine.WorkflowRegistry.Sql" />
    <PackageReference Include="EF.FlowEngine.HumanTaskStore.Sql" />
    <PackageReference Include="EF.FlowEngine.Outbox.Sql" />
    <PackageReference Include="EF.FlowEngine.CircuitBreaker.Sql" />
    <PackageReference Include="EF.FlowEngine.Clients.Http" />
    <PackageReference Include="EF.FlowEngine.Clients.AI" />
    <PackageReference Include="EF.FlowEngine.Clients.ServiceBus" />
    <PackageReference Include="EF.FlowEngine.AdminApi" />
    <PackageReference Include="Aspire.Azure.AI.Inference" />
    <!-- D-042: Microsoft.FeatureManagement; Azure App Configuration comes from EF.Host. -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="EF.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Deployed (D-041): the OpenAICompatible arm goes through EF.AI, which carries the SDK itself. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
