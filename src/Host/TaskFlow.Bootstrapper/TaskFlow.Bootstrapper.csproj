    <ProjectReference Include="..\..\Infrastructure\TaskFlow.Infrastructure.Messaging.RabbitMq\TaskFlow.Infrastructure.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\Shared\TaskFlow.Observability\TaskFlow.Observability.csproj" />
