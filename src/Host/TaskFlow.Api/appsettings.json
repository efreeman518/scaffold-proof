{
  "Application": {
    "Style": "Service"
  },
  "AppName": "TaskFlowApi",
  "AuthMode": "Scaffold",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "ForwardedHeaders": {
      "Enabled": false,
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": [],
      "AllowedHosts": []
    },
    "PathBase": ""
  },
  "ConnectionStrings": {
    "TaskFlowDbContextTrxn": "",
    "TaskFlowDbContextQuery": "",
    "TaskFlowFlowEngineDbContext": "",
    "Redis1": "",
    "BlobStorage1": "",
    "TableStorage1": "",
    "ServiceBus1": "",
    "CosmosDb1": ""
  },
  "ForwardedClaims": {
    "HeaderName": "X-Forwarded-User-Claims",
    "ClaimTypes": [
      "sub", "oid", "name", "roles",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
      "http://schemas.microsoft.com/ws/2008/06/identity/claims/role",
      "tenant_id"
    ],
    "TrustedCallerIds": [],
    "ServicePathPrefixes": [ "/health" ]
  },
  "AuditLogStorageSettings": {
    "TableName": "taskflowaudit",
    "Audit": {
      "SystemTenantId": "_system"
    }
  },
  "BlobStorageSettings": {
    "ContainerName": "attachments"
  },
  "CacheSettings": [
    {
      "Name": "TaskFlowCache",
      "DurationMinutes": 30,
      "DistributedCacheDurationMinutes": 60,
      "FailSafeMaxDurationMinutes": 120,
      "FailSafeThrottleDurationSeconds": 1,
      "JitterMaxDurationSeconds": 10,
      "FactorySoftTimeoutSeconds": 1,
      "FactoryHardTimeoutSeconds": 30,
      "EagerRefreshThreshold": 0.9,
      "RedisConnectionStringName": "Redis1",
      "BackplaneChannelName": "taskflow-cache-sync"
    }
  ],
  "Database": {
    "Retry": {
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 30
    }
  },
  "FeatureFlags": {
    "EnableNotifications": false
  },
  "AppConfig": {
    "Endpoint": "",
    "Label": ""
  },
  "FeatureManagement": {
    "TaskViews": true,
    "Export": true,
    "SemanticSearch": true,
    "AiReview": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FlowEngine": {
    "SelfCall": {
      "TokenScope": ""
    }
  },
  "RequestTimeouts": {
    "DefaultSeconds": 30
  },
  "RateLimiting": {
    "Tenants": {
      "TenantClaimType": "tenant_id",
      "DefaultTier": "standard",
      "Tiers": {
        "free": { "PermitLimit": 20, "WindowSeconds": 60 },
        "standard": { "PermitLimit": 100, "WindowSeconds": 60 },
        "premium": { "PermitLimit": 1000, "WindowSeconds": 60 }
      },
      "TenantTiers": {},
      "Budgets": {
        "export": { "PermitLimit": 5, "WindowSeconds": 60 },
        "workflow": { "PermitLimit": 300, "WindowSeconds": 60 }
      }
    },
    "Workflow": {
      "CallerIds": []
    },
    "Health": {
      "MemoryPermitLimit": 30,
      "DbPermitLimit": 6,
      "FullPermitLimit": 3
    }
  },
  "HealthChecks": {
    "EnableExternalServices": false
  },
  "AiServices": {
    "UseSearch": false,
    "UseAgents": false,
    "UseVectorSearch": false,
    "FoundryEndpoint": "",
    "AgentModelDeployment": "chat-deploy",
    "EmbeddingModelDeployment": "embedding-deploy",
    "SearchEndpoint": "",
    "SearchIndexName": "taskitems-index",
    "Endpoint": "",
    "ApiKey": "",
    "ChatModel": "",
    "EmbeddingModel": ""
  },
  "Cosmos": {
    "TaskViews": {
      "DatabaseName": "taskflow-db",
      "ContainerName": "task-views"
    }
  }
}
