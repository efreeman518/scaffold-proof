<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- D-047 shared host runtime profile (Server GC + DATAS, PGO, invariant globalization). -->
  <Import Project="..\TaskFlow.Host.props" />

  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Committed src/Host/TaskFlow.Api/openapi-doc/TaskFlow.Api.json is the Refitter/openapi-typescript
         input so client generation runs offline. See docs/plans/client-generation.md for the exact
         regeneration command. Directory is "openapi-doc", not "openapi": the project already has an
         "OpenApi/" C# source folder, and Windows' case-insensitive filesystem would merge the two,
         mixing generated JSON into hand-authored source (and diverging from a case-sensitive Linux CI
         checkout).
         OnBuild is deliberately false: this host's Program.cs runs real startup (EF migrations,
         FlowEngine workflow seeding, column-encryption key validation) to build the OpenAPI document,
         so generating it on every ordinary build/test run would make every build of every project that
         references TaskFlow.Api require a reachable database and encryption keys. Regeneration is an
         explicit step (dotnet build ... /t:GenerateOpenApiDocuments) run only when the HTTP contract
         changes. Test.Endpoints' drift-guard test (OpenApiEndpointTests) still catches a forgotten
         regeneration by comparing this file to the live /openapi/v1.json. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi-doc</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <!-- D-047: the Dockerfile publishes with PublishReadyToRun=true, and crossgen2 needs the full assembly
       closure of everything it precompiles. Microsoft.Agents.AI.OpenAI arrives transitively and references
       OpenAI, which this project declares PrivateAssets="all" precisely so it is NOT deployed - so that
       reference is dangling in the publish output by design and crossgen2 fails on it (NETSDK1096, "Failed
       to load assembly 'OpenAI'"). Excluding it from R2R costs nothing: an assembly whose dependency is
       absent cannot be on a hot path, or on any path. Remove this line if OpenAI ever becomes a deployed
       dependency of the Api. No-op when PublishReadyToRun is off (ordinary build and test). -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Agents.AI.OpenAI.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="EF.AspNetCore" />
    <PackageReference Include="EF.Common" />
    <!-- FlowEngine packages live in TaskFlow.Bootstrapper where DI registration happens.
         Only AdminApi is referenced here for the pipeline mapping. -->
    <PackageReference Include="EF.FlowEngine.AdminApi" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Aspire.Azure.AI.Inference" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenAI" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Direct references participate in the documented Roslyn exact-family exception in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskFlow.Bootstrapper\TaskFlow.Bootstrapper.csproj" />
    <ProjectReference Include="..\..\Application\TaskFlow.Application.Contracts\TaskFlow.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\Application\TaskFlow.Application.Models\TaskFlow.Application.Models.csproj" />
    <ProjectReference Include="..\..\Application\TaskFlow.Application.Cqrs\TaskFlow.Application.Cqrs.csproj" />
    <ProjectReference Include="..\..\Infrastructure\TaskFlow.Infrastructure.AI\TaskFlow.Infrastructure.AI.csproj" />
    <ProjectReference Include="..\Aspire\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\TaskFlow.Observability\TaskFlow.Observability.csproj" />
  </ItemGroup>

</Project>
