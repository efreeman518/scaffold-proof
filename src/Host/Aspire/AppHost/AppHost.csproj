<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>1ff79f7a-4df8-4442-a9ed-762565d2e039</UserSecretsId>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <!-- D-034: declares the local RabbitMQ broker when Messaging:Provider is RabbitMq. -->
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" />
    <PackageReference Include="Aspire.Hosting.Azure.CognitiveServices" />
    <PackageReference Include="Aspire.Hosting.Azure.Search" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Aspire" />
  </ItemGroup>

  <!-- SkipUnoWasmBuild (passed by a direct test-project build) concerns only the Uno WASM host. Removing it from every
       other reference, including the transitive references the SDK adds, keeps one configuration per project, shared
       with the test project's own references, instead of building each a second time into the same obj folders. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>SkipUnoWasmBuild</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\TaskFlow.Hosting\TaskFlow.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\TaskFlow.Api\TaskFlow.Api.csproj" />
    <ProjectReference Include="..\..\TaskFlow.DatabaseMigrator\TaskFlow.DatabaseMigrator.csproj" />
    <ProjectReference Include="..\..\TaskFlow.Scheduler\TaskFlow.Scheduler.csproj" />
    <ProjectReference Include="..\..\TaskFlow.Gateway\TaskFlow.Gateway.csproj" />
    <ProjectReference Include="..\..\TaskFlow.Functions\TaskFlow.Functions.csproj" />
    <ProjectReference Include="..\..\..\UI\TaskFlow.Blazor\TaskFlow.Blazor.csproj" />
    <ProjectReference Include="..\..\TaskFlow.Uno.WasmHost\TaskFlow.Uno.WasmHost.csproj" GlobalPropertiesToRemove="" />
  </ItemGroup>

</Project>
