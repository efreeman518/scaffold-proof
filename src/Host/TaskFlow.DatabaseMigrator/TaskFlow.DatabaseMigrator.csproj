<Project Sdk="Microsoft.NET.Sdk">

  <!-- D-047 shared host runtime profile; the override below follows it deliberately. -->
  <Import Project="..\TaskFlow.Host.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Workstation GC: this host is a run-to-completion migration job, not a request server. Server GC
         would reserve per-core heaps and spin up GC threads for a process that exits in seconds, which
         costs startup time and container memory for no throughput it can use. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EF.Data" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\TaskFlow.Infrastructure.Data\TaskFlow.Infrastructure.Data.csproj" />
    <!-- Both provider migration sets ship with the migrator; UseTaskFlowProvider picks one by MigrationsAssembly (D-025). -->
    <ProjectReference Include="..\..\Infrastructure\TaskFlow.Infrastructure.Data.Migrations.SqlServer\TaskFlow.Infrastructure.Data.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\Infrastructure\TaskFlow.Infrastructure.Data.Migrations.PostgreSql\TaskFlow.Infrastructure.Data.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\Aspire\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
