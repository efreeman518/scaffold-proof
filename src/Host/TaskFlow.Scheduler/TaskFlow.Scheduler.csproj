<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- D-047 shared host runtime profile (Server GC + DATAS, PGO, invariant globalization). -->
  <Import Project="..\TaskFlow.Host.props" />

  <PropertyGroup>
    <!-- This host opens real Microsoft.Data.SqlClient connections (Database:Provider=SqlServer, via
         TaskFlow.Infrastructure.Data through Bootstrapper), and SqlClient throws NotSupportedException
         under invariant globalization. Paired with the -chiseled-extra runtime image in this project's
         Dockerfile, which carries ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package request 11: the leased-worker drain loop the outbox and blob-delete workers derive from. -->
    <PackageReference Include="EF.BackgroundServices" />
    <PackageReference Include="EF.Storage.Contracts" />
    <PackageReference Include="EF.Audit.Contracts" />
    <PackageReference Include="TickerQ" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" />
    <PackageReference Include="TickerQ.Dashboard" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- D-034: registers the singleton IConnection the RabbitMQ multiplexer reuses when RabbitMq is selected. -->
    <PackageReference Include="Aspire.RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskFlow.Bootstrapper\TaskFlow.Bootstrapper.csproj" />
    <ProjectReference Include="..\Aspire\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\TaskFlow.Observability\TaskFlow.Observability.csproj" />
  </ItemGroup>

</Project>
