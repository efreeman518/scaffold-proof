{
  "AppName": "TaskFlowScheduler",
  "AppConfig": {
    "Endpoint": "",
    "Label": ""
  },
  "FeatureManagement": {
    "AiReview": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TickerQ": "Information"
    }
  },
  "AllowedHosts": "*",
  "OutboxDispatcher": {
    "MaxAttempts": 10
  },
  "BlobDelete": {
    "MaxConcurrency": 8,
    "MaxAttempts": 10
  },
  "ConnectionStrings": {
    "TaskFlowDbContextTrxn": "",
    "TaskFlowDbContextQuery": "",
    "TaskFlowFlowEngineDbContext": "",
    "TickerQDbContext": "",
    "Redis1": "",
    "TableStorage1": ""
  },
  "CacheSettings": [
    {
      "Name": "TaskFlowCache",
      "DurationMinutes": 30,
      "DistributedCacheDurationMinutes": 60,
      "FailSafeMaxDurationMinutes": 120,
      "FailSafeThrottleDurationSeconds": 1,
      "JitterMaxDurationSeconds": 10,
      "FactorySoftTimeoutSeconds": 1,
      "FactoryHardTimeoutSeconds": 30,
      "EagerRefreshThreshold": 0.9,
      "RedisConnectionStringName": "Redis1"
    }
  ],
  "Database": {
    "Retry": {
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 30
    }
  },
  "AuditLogStorageSettings": {
    "TableName": "taskflowaudit",
    "Audit": {
      "SystemTenantId": "_system",
      "RetentionDays": 30
    }
  },
  "ForwardedClaims": {
    "HeaderName": "X-Forwarded-User-Claims",
    "ClaimTypes": [
      "sub", "oid", "name", "roles",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
      "http://schemas.microsoft.com/ws/2008/06/identity/claims/role",
      "tenant_id"
    ]
  },
  "FlowEngine": {
    "SelfCall": {
      "TokenScope": ""
    }
  },
  "Cosmos": {
    "TaskViews": {
      "DatabaseName": "taskflow-db",
      "ContainerName": "task-views"
    }
  },
  "Scheduling": {
    "UsePersistence": true,
    "EnableDashboard": false,
    "MaxConcurrency": 5,
    "PollIntervalSeconds": 30,
    "OwnsRetention": true,
    "StaleCleanup": {
      "RetentionDays": 90
    },
    "Compliance": {
      "WindowDays": 7
    },
    "Retention": {
      "OutboxDays": 7,
      "ConsumerInboxDays": 7,
      "IdempotencyKeyDays": 7,
      "OccurrenceRetention": "1.00:00:00"
    },
    "Health": {
      "StallThreshold": "12:00:00"
    },
    "Dashboard": {
      "BasePath": "/scheduler",
      "Username": "",
      "Password": "",
      "SessionTimeoutMinutes": 60
    }
  }
}
