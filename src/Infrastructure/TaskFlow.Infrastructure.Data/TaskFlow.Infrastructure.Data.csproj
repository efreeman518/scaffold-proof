<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="EF.Data" />
    <!-- D-023 column encryption: the package owns the AES-GCM converter, blind index and Key Vault DEK unwrap. -->
    <PackageReference Include="EF.Data.Encryption" />
    <PackageReference Include="EF.Common.Contracts" />
    <PackageReference Include="EF.Domain.Contracts" />
    <PackageReference Include="EF.FlowEngine.StateStore.Sql" />
    <PackageReference Include="EF.FlowEngine.Outbox.Sql" />
    <PackageReference Include="EF.FlowEngine.WorkflowRegistry.Sql" />
    <PackageReference Include="EF.FlowEngine.HumanTaskStore.Sql" />
    <PackageReference Include="EF.FlowEngine.CircuitBreaker.Sql" />
    <!-- Both relational providers ship in the data assembly; UseTaskFlowProvider selects one at runtime (D-020). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- D-040: the TaskItemEmbedding row is mapped only on Npgsql, but the Vector type and UseVector()
         extension have to be compiled in for the branch to exist at all. -->
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-026: the outbox staging interceptor writes IntegrationEventEnvelope rows. Infrastructure may know
         Application.Contracts (ports), never Application.Services (implementations). -->
    <ProjectReference Include="..\..\Application\TaskFlow.Application.Contracts\TaskFlow.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\Domain\TaskFlow.Domain.Model\TaskFlow.Domain.Model.csproj" />
    <ProjectReference Include="..\..\Domain\TaskFlow.Domain.Shared\TaskFlow.Domain.Shared.csproj" />
    <ProjectReference Include="..\..\Shared\TaskFlow.Observability\TaskFlow.Observability.csproj" />
  </ItemGroup>

</Project>
