{
  "name": "taskflow-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "taskflow": {
    "toolingNotes": {
      "typescript": "Pinned to ~6.0.3 because typescript-eslint 8.71 supports TypeScript >=4.8.4 <6.1.0. Remove this pin when typescript-eslint supports the next selected TypeScript line. Validating check: npm ci --prefix src/UI/TaskFlow.React (ci.yml, deploy.yml) fails on typescript-eslint's peer range when TypeScript moves outside it; run npm run lint after any bump."
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../Host/TaskFlow.Api/openapi-doc/TaskFlow.Api.json -o src/api/types.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
