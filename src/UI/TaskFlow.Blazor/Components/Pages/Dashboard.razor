@page "/"
@inject FloatService FloatService
@inject ITaskFlowApiClient Api
@inject TaskFlow.Contracts.Grpc.TaskFlowRead.TaskFlowReadClient GrpcReads
@inject ClientReadSettings ReadSettings
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Dashboard - TaskFlow</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" data-testid="page-title" Class="mb-4">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2">
            <MudText Typo="Typo.overline">Total</MudText>
            <MudText Typo="Typo.h3">@_total</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2">
            <MudText Typo="Typo.overline">Open</MudText>
            <MudText Typo="Typo.h3" Color="Color.Info">@_open</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2">
            <MudText Typo="Typo.overline">In Progress</MudText>
            <MudText Typo="Typo.h3" Color="Color.Warning">@_inProgress</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2">
            <MudText Typo="Typo.overline">Completed</MudText>
            <MudText Typo="Typo.h3" Color="Color.Success">@_completed</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-6" Elevation="2">
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h6">Recent Tasks</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/tasks/new"))">New Task</MudButton>
        <MudButton Class="ml-2" StartIcon="@Icons.Material.Filled.List"
                   OnClick="@(() => Nav.NavigateTo("/tasks"))">View All</MudButton>
    </div>

    <MudTable Items="_recent" Hover="true" Dense="true" Loading="@_loading" Elevation="0">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh>Due</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd>@context.Status</MudTd>
            <MudTd>@context.Priority</MudTd>
            <MudTd>@(context.DueDate?.LocalDateTime.ToString("yyyy-MM-dd") ?? "-")</MudTd>
            <MudTd>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => Nav.NavigateTo($"/tasks/{context.Id}"))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No tasks found.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private int _total;
    private int _open;
    private int _inProgress;
    private int _completed;
    private bool _loading;
    private List<TaskItemDto> _recent = new();

    protected override async Task OnInitializedAsync()
    {
        FloatService.ModuleName = "Dashboard";
        FloatService.TaskItemsChanged += OnTaskItemsChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        // D-054: the same read over the internal gRPC hop or over REST through the gateway. Both arms
        // return the identical DTO, which is the point of the proof.
        var summary = await FloatService.ExecuteWithProgressAsync(
            () => ReadSettings.UseGrpcReads
                ? GrpcReads.GetTaskItemSummaryDtoAsync()
                : Api.GetTaskItemSummaryAsync(),
            "Failed to load task summary.");
        if (summary is not null)
        {
            _total = summary.Total;
            _open = CountOf(summary, TaskItemStatus.Open);
            _inProgress = CountOf(summary, TaskItemStatus.InProgress);
            _completed = CountOf(summary, TaskItemStatus.Completed);
        }

        // One cursor page for the recent-tasks preview; the tile counts above already come from the
        // tenant-wide summary, not from this page, so there is no double round trip to page through.
        var recent = await FloatService.ExecuteWithProgressAsync(
            () => Api.SearchTaskItemsAsync(new TaskItemCursorSearchRequest
            {
                SortMode = TaskItemSortMode.ModifiedDesc,
                PageSize = 8
            }),
            "Failed to load recent tasks.");
        _recent = recent?.Items.ToList() ?? [];

        _loading = false;
    }

    private static int CountOf(TaskItemSummaryDto summary, TaskItemStatus status) =>
        summary.ByStatus.FirstOrDefault(s => s.Status == status)?.Count ?? 0;

    private async void OnTaskItemsChanged()
    {
        await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        FloatService.TaskItemsChanged -= OnTaskItemsChanged;
    }
}
