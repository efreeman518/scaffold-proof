    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="EF.Packages.Enterprise (Private Feed)">
    <PackageVersion Include="EF.FilterBuilder" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.StateStore.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.Locks.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.WorkflowRegistry.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.HumanTaskStore.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.Outbox.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.CircuitBreaker.Sql" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.Clients.AI" Version="1.0.163" />
