    <PackageVersion Include="EF.Cache" Version="1.0.88" />
    <PackageVersion Include="EF.IntegrationTesting" Version="1.1.98" />
    <!-- Extended packages - add to individual .csproj when needed -->
    <PackageVersion Include="EF.Auth" Version="1.0.88" />
    <PackageVersion Include="EF.Messaging" Version="1.1.98" />
    <PackageVersion Include="EF.Storage" Version="1.1.98" />
