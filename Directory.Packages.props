    <PackageVersion Include="EF.FlowEngine.Clients.ServiceBus" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.AdminApi" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.Dashboard" Version="1.0.163" />
    <PackageVersion Include="EF.FlowEngine.Testing" Version="1.0.163" />
