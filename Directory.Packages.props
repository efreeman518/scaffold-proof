<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- One Uno.Extensions version for the Uno head and the shared Uno libraries. Uno.Sdk reads this property for
         its implicit Uno.Extensions references (its own default, 8.0.0-dev.118, depends on an older Uno.WinUI
         than the SDK's Uno.WinUI 7.0.0-dev.2428; 8.0.0-dev.135 depends on that same Uno.WinUI). -->
    <UnoExtensionsVersion>8.0.0-dev.135</UnoExtensionsVersion>
  </PropertyGroup>
  <ItemGroup Label="EF.Packages (Private Feed - github.com/efreeman518/EF.Packages)">
    <!-- Core packages - always available -->
    <PackageVersion Include="EF.CQRS" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Domain" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Domain.Contracts" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Data" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Data.Contracts" Version="3.0.0-dotnet11.144" />
    <!-- D-023 column encryption: provider-neutral AES-GCM converter, blind index, Key Vault DEK unwrap (package request 5). -->
    <PackageVersion Include="EF.Data.Encryption" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Data.PostgreSql" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Data.SqlServer" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Common" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Common.Contracts" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Tenancy" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Host" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.AspNetCore" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.BackgroundServices" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Cache" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.IntegrationTesting" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.IntegrationTesting.Aspire" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.IntegrationTesting.PostgreSql" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.IntegrationTesting.SqlServer" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Testing" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Testing.Architecture" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.AI.Testing" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Messaging" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Messaging.RabbitMq" Version="3.0.0-dotnet11.144" />
    <!-- M1/M8/M16: transport-neutral messaging contracts, the EF Core outbox/inbox/leased-work tables, and the Functions Service Bus adapter. -->
    <PackageVersion Include="EF.Messaging.Contracts" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Data.Outbox" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Messaging.Functions" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Storage" Version="3.0.0-dotnet11.144" />
    <!-- Provider-neutral object-storage contract both storage arms implement (D-037, package request 25). -->
    <PackageVersion Include="EF.Storage.Contracts" Version="3.0.0-dotnet11.144" />
    <!-- D-037 NonAzure object-storage arm: the published S3 repository, bucket provisioner, and DI wiring. -->
    <PackageVersion Include="EF.Storage.S3" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Table" Version="3.0.0-dotnet11.144" />
    <!-- Backend-neutral audit sink contract both audit arms implement (D-039, package request 26). -->
    <PackageVersion Include="EF.Audit.Contracts" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Audit.AzureTable" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Audit.Data" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Grpc" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.AI" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <!-- Generic containers host SeaweedFS and MongoDB without provider-specific fixture packages. -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup Label="EF.Packages hosting, web and UI client">
    <PackageVersion Include="EF.AspNetCore.DataProtection" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Http.Resilience" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.OpenTelemetry" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.UI.Client" Version="3.0.0-dotnet11.144" />
  </ItemGroup>
  <ItemGroup Label="EF.Packages auth, gateway, rate limiting, scheduler, storage">
    <PackageVersion Include="EF.Auth" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.Gateway" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.RateLimiting" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.RateLimiting.Redis" Version="3.0.0-dotnet11.144" />
    <!-- Database-coordinated cron and on-demand job scheduler on EF Core; the Scheduler host executes it. -->
    <PackageVersion Include="EF.Data.Scheduling" Version="3.0.0-dotnet11.144" />
    <PackageVersion Include="EF.CosmosDb" Version="3.0.0-dotnet11.144" />
  </ItemGroup>
  <ItemGroup Label="EF.Packages.Enterprise (Private Feed)">
    <PackageVersion Include="EF.FilterBuilder" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.StateStore.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Locks.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.WorkflowRegistry.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.HumanTaskStore.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Outbox.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.CircuitBreaker.Sql" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Clients.AI" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Clients.Http" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Clients.ServiceBus" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.AdminApi" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Dashboard" Version="2.0.0-dotnet11.269" />
    <PackageVersion Include="EF.FlowEngine.Testing" Version="2.0.0-dotnet11.269" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" />
    <!-- Dual-provider dependency (Phase 0 pin, no PackageReference yet) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.2" />
    <!-- D-040 pgvector semantic search: Vector type + the EF Core mapping/UseVector extension. Postgres-only
         by construction; the SQL Server arm of the search switch fails fast instead of mapping the entity. -->
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>
  <!-- Temporary exception: FlowEngine's scripting dependency requires one exact Roslyn family and mixed families fail migration tooling at runtime.
       Reason: align every direct Roslyn package to the family selected by current FlowEngine. Remove when FlowEngine permits the latest stable Roslyn family.
       Validate with restore plus the migration pending-model gate for every DbContext before and after removal. -->
  <ItemGroup Label="Roslyn exact-family alignment">
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft ASP.NET Core">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
    <!-- Build-time OpenAPI document generation so the committed src/Host/TaskFlow.Api/openapi-doc/TaskFlow.Api.json
         stays in sync with the runtime document without a running server (client codegen goes offline). -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Functions" Version="13.6.4" />
    <!-- Temporary exception: held at the KubernetesClient release Aspire.Hosting 13.6.4 is built against (21.x is a
         major release Aspire has not adopted; Aspire's DCP client calls go through it).
         Reason: a major bump under Aspire's own dependency risks AppHost/DCP runtime breaks. Remove when Aspire.Hosting
         depends on KubernetesClient 21 or later. Validate with Test.Aspire topology contracts. -->
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
  </ItemGroup>
  <ItemGroup Label="RabbitMQ (Aspire hosting/client plus the integration tests' own broker client)">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- D-034: Aspire hosting declares the local broker; the client integration registers the singleton
         IConnection that the package multiplexer reuses instead of opening a second one. -->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.4" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup Label="gRPC (D-054 internal read service)">
    <!-- Grpc.Tools is a build-time-only protoc/codegen package: referenced with PrivateAssets=all in the
         contracts project, so it never flows to consumers or the publish output. -->
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup Label="YARP">
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Azure Functions">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.2" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <!-- Microsoft.Testing.Platform hang dump diagnostics for the CI Test.Unit step; the MSTest metapackage
         already brings the TRX report and code coverage extensions. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- Test.Architecture reads IL directly (ConcurrencyGuard policy check); same version EF.Testing.Architecture uses. -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageVersion Include="Uno.Extensions.Navigation" Version="$(UnoExtensionsVersion)" />
    <PackageVersion Include="Uno.Extensions.Navigation.WinUI" Version="$(UnoExtensionsVersion)" />
    <PackageVersion Include="Uno.Extensions.Reactive" Version="$(UnoExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup Label="Security transitive overrides">
    <!-- Not a transitive-override exception: first-class direct dependency since D-048, Infrastructure.Caching
         references MessagePack directly for ContractlessStandardResolver. Pinned here, alongside its former
         exception neighbors, for centralized version control.
         Validate with the Infrastructure.Caching consumers and the Test.Support build. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- Temporary exception: Aspire.Hosting.SqlServer reaches Microsoft.Data.SqlClient, which resolves a vulnerable
         System.Security.Cryptography.Pkcs 10.0.12 in AppHost (a console project, where Pkcs is not part of the shared
         framework and so is not pruned) (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx).
         Reason: direct reference lifts the vulnerable transitive. Remove when the parents resolve a non-vulnerable release.
         Validate with the transitive vulnerability audit (AppHost consumer). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
    <!-- Temporary exception: shared test packages resolve vulnerable SSH.NET transitives.
         Reason: direct reference lifts every affected transitive. Remove when the parents resolve a non-vulnerable release.
         Validate with the transitive vulnerability audit and the Test.Support consumers. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup Label="Azure Storage">
    <PackageVersion Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="AWS S3 (D-037 NonAzure object-storage arm: SeaweedFS locally/on the VPS, any S3-compatible provider in production)">
    <!-- The S3 arm itself is EF.Storage.S3; this direct reference exists for Test.Integration, which drives
         SeaweedFS with its own IAmazonS3 client. Version tracks EF.Storage.S3's own dependency (no downgrade). -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.7" />
  </ItemGroup>
  <ItemGroup Label="Azure Service Bus">
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="Azure Cosmos DB">
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.3" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="MongoDB">
    <!-- D-038/D-060 explicit NonAzure TaskView alternative. -->
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
  </ItemGroup>
  <ItemGroup Label="Feature flags">
    <!-- D-042: Azure App Configuration itself comes from EF.Host. -->
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <!-- Infrastructure.AI checks AiReview via IVariantFeatureManager without the ASP.NET Core-specific package. -->
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Label="AI Services">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.CognitiveServices" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Search" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <!-- Temporary exception: Azure AI Inference has no stable package release.
         Reason: use its latest compatible preview release for the enabled Azure AI proof. Remove when a stable release exists.
         Validate with restore, full build, Test.Aspire AI topology, and the Azure live-provider lane. -->
    <PackageVersion Include="Aspire.Azure.AI.Inference" Version="13.6.4-preview.1.26523.11" />
  </ItemGroup>
</Project>
